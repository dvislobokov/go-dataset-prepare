{
  "config_version": "go-base/1",
  "repository_id": "local/unknown",
  "seed": 20261009,
  "license": {
    "allowlist": [
      "MIT",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "0BSD",
      "Unlicense",
      "ISC",
      "Zlib"
    ],
    "declared": null,
    "allow_unknown": false
  },
  "discovery": {
    "include": [
      "**/*.go"
    ],
    "exclude": [
      "**/.git/**",
      "**/node_modules/**"
    ],
    "generated_patterns": [
      "**/*.pb.go",
      "**/*.pb.gw.go",
      "**/*.pb.validate.go",
      "**/*_gen.go",
      "**/*.gen.go",
      "**/zz_generated*.go",
      "**/*_generated.go",
      "**/bindata.go"
    ],
    "generated_markers": [
      "(?i)\\b(auto-?generated|code generated|generated by)\\b[^\\n]{0,120}\\bdo not (edit|modify)\\b",
      "(?i)\\bdo not (edit|modify)\\b[^\\n]{0,120}\\b(auto-?generated|generated)\\b"
    ],
    "vendored_patterns": [
      "vendor/**",
      "**/vendor/**",
      "**/third_party/**",
      "**/third-party/**",
      "**/_vendor/**"
    ],
    "testdata_patterns": [
      "testdata/**",
      "**/testdata/**"
    ],
    "test_patterns": [
      "**/*_test.go"
    ],
    "skip_go_ignored_dirs": true,
    "max_file_bytes": 1048576,
    "max_file_line_chars": 2000,
    "build_context": {
      "goos": "linux",
      "goarch": "amd64",
      "cgo": false,
      "tags": null
    },
    "build_excluded_policy": "keep_tagged"
  },
  "sampling": {
    "weights": {
      "after_keyword": 0.5,
      "after_operator": 0.4,
      "argument_list": 0.5,
      "composite_literal": 0.4,
      "control_flow": 0.6,
      "error_handling": 0.6,
      "func_literal": 0.8,
      "identifier_partial": 0.035,
      "line_start": 0.7,
      "log_message": 1,
      "member_access": 0.8,
      "token_boundary": 0.02
    },
    "max_samples_per_line": 2,
    "drop_duplicate_line_targets": true,
    "max_samples_per_file": 300,
    "identifier_prefix_max": 4,
    "max_line_chars": 240,
    "min_target_chars": 1,
    "max_target_chars": 200,
    "trivial_target_keep_probability": 0.05,
    "exclusion_examples_per_reason": 25,
    "keep_fraction": 1,
    "test_keep_fraction": 1,
    "max_samples_per_repo": 0
  },
  "context": {
    "left_chars": 6000,
    "right_chars": 1000
  },
  "split": {
    "repository_split": "train",
    "repository_group": null
  },
  "semantic": {
    "mode": "none",
    "policies": [
      "editor_snapshot",
      "strict_prefix"
    ],
    "subset_fraction": 1,
    "max_scope_symbols": 48,
    "max_members": 48,
    "max_package_files": 400,
    "use_vendor": true,
    "engine": "auto"
  },
  "secrets": {
    "patterns": [
      "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "\\bAKIA[0-9A-Z]{16}\\b",
      "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b",
      "\\bgithub_pat_[A-Za-z0-9_]{60,}\\b",
      "\\bxox[baprs]-[A-Za-z0-9-]{10,}",
      "\\bsk_live_[0-9a-zA-Z]{24,}\\b",
      "\\bAIza[0-9A-Za-z_-]{35}\\b",
      "(?i)AccountKey=[A-Za-z0-9+/=]{20,}",
      "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"
    ],
    "line_patterns": [
      "(?i)\\b\\w*(password|passwd|pwd|secret|apikey|api_key|accesstoken|access_token|authtoken|auth_token)\\w*\"?\\s*(:=|=|:)\\s*[\"`]([^\"`\\s{}%$]{8,})[\"`]"
    ]
  }
}
