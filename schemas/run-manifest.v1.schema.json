{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flc-dataset.local/schemas/run-manifest.v1.schema.json",
  "title": "run-manifest/v1 — provenance, config, environment, timings, resources, output checksums",
  "type": "object",
  "required": ["schema_version","generator","repository_id","revision","config","config_sha256","seed","workers","semantic_mode","timings","resources","throughput","outputs","environment"],
  "properties": {
    "schema_version": { "const": "run-manifest/v1" },
    "generator": { "type": "string" },
    "command_line": { "type": "array", "items": { "type": "string" } },
    "repository_id": { "type": "string" },
    "revision": { "type": ["string","null"], "pattern": "^[0-9a-f]{40}$" },
    "repo_root": { "type": "string" },
    "license": { "type": ["string","null"] },
    "license_reason": { "type": ["string","null"] },
    "module_path": { "type": ["string","null"] },
    "go_directive": { "type": ["string","null"] },
    "seed": { "type": "integer" },
    "semantic_mode": { "enum": ["none","best_effort","required"] },
    "config": { "type": "object" },
    "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workers": { "type": "integer", "minimum": 1 },
    "started_at": { "type": "string" },
    "environment": { "type": "object" },
    "timings": {
      "type": "object",
      "required": ["wall_ms","stages","file_latency_ms"],
      "properties": {
        "wall_ms": { "type": "number" },
        "stages": { "type": "object", "description": "Per-stage CPU time in ms (discovery, syntax, semantic, write)." },
        "file_latency_ms": { "type": "object", "required": ["p50","p95","p99","max"] }
      }
    },
    "resources": { "type": "object", "required": ["peak_rss_bytes","input_bytes_discovered"] },
    "throughput": { "type": "object", "required": ["samples_per_sec","source_mib_per_sec","files_per_sec"] },
    "outputs": { "type": "object", "description": "filename -> sha256 of the written file (for checksum verification)." }
  }
}
